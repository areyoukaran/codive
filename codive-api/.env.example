# Copy this to .env and fill in what you have. The app boots with none of
# this set — /health will just list what's missing and the related
# features stay off until you add it. Nothing here costs money; see
# README.md for exactly where to get each value for free.

ENV=development

# --- required to persist anything ---
# Free Postgres with pgvector: https://neon.tech — copy the connection
# string from your project dashboard. Starts postgresql://... ; either
# that or the +asyncpg form both work, the app normalizes it.
DATABASE_URL=

# --- required for sign-in and encrypted token storage ---
# Generate both with: python3 scripts/gen-keys.py
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=

# --- required for "Connect GitHub" to work ---
# Create at https://github.com/settings/developers -> New OAuth App
#   Homepage URL:               http://localhost:5173  (or your deployed frontend URL)
#   Authorization callback URL: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional but recommended once you're deployed: create a webhook secret
# (any random string) and use it both here and when you add a webhook on
# each GitHub repository pointing at {BACKEND_URL}/webhooks/github. Without
# this, Codive still works — it just relies on the polling schedule
# below instead of near-real-time push events.
GITHUB_WEBHOOK_SECRET=

# --- where your frontend and backend actually live ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- optional: real AI instead of the templated fallback ---
# Groq: https://console.groq.com/keys — free, no card.
GROQ_API_KEY=
# Gemini: https://aistudio.google.com/apikey — free, no card. Used if set
# and GROQ_API_KEY is not, or if LLM_PROVIDER=gemini below.
GEMINI_API_KEY=
LLM_PROVIDER=auto
EMBEDDING_PROVIDER=auto

# --- optional: shared rate limiting / caching across instances ---
# Upstash: https://console.upstash.com — free, no card. Use the "redis://"
# or "rediss://" connection string it gives you, not the REST URL.
REDIS_URL=

# --- tuning (sensible defaults, change only if you know you want to) ---
SYNC_INTERVAL_MINUTES=20
BRIEF_HOUR_UTC=5
MAX_REPOS_PER_ACCOUNT=8
ENABLE_SCHEDULER=true
RATE_LIMIT_PER_MINUTE=60
ASK_RATE_LIMIT_PER_MINUTE=6
COOKIE_SECURE=false
